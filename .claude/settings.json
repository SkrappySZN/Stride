{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-sync.sh\" start",
            "timeout": 30,
            "statusMessage": "Pulling the latest from GitHub"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-sync.sh\" push",
            "timeout": 30,
            "statusMessage": "Pulling before push"
          }
        ]
      }
    ]
  }
}
