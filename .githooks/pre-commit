#!/bin/sh
# Refuse to commit personal data. The repo is public and GitHub Pages serves
# index.html straight from main, so whatever is committed goes live.
#
# .leakwords is gitignored: the list IS the sensitive data, and it only exists
# on Neil's machine. Without it there's nothing personal to check, so the hook
# passes.
# Enable once per clone:  git config core.hooksPath .githooks
set -eu

LW=".leakwords"
[ -r "$LW" ] || exit 0
PATTERN=$(grep -v '^[[:space:]]*#' "$LW" | grep -v '^[[:space:]]*$' \
          | sed 's/[.[\*^$()+?{}|]/\\&/g' | paste -sd'|' -)
[ -n "$PATTERN" ] || exit 0

fail=0
# every tracked file plus what's staged, so a leak can't hide in an old file
for f in $( (git ls-files; git diff --cached --name-only --diff-filter=ACM) | sort -u ); do
  case "$f" in *.woff2|*.png|*.jpg|*.ttf) continue ;; esac
  [ -f "$f" ] || continue
  hits=$(grep -nE "$PATTERN" "$f" 2>/dev/null | head -3 || true)
  if [ -n "$hits" ]; then
    echo "pre-commit: $f contains personal data from $LW:"
    echo "$hits" | cut -c1-140
    fail=1
  fi
done
[ "$fail" = 0 ] || { echo "REFUSING. Remove it before committing."; exit 1; }
exit 0
